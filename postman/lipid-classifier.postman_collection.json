    {
      "name": "2. Jobs",
      "item": [
        {
          "name": "Upload mzML spectrum",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a job id and PENDING status', function () {",
                  "    pm.expect(body).to.have.property('job_id');",
                  "    pm.expect(body.status).to.eql('PENDING');",
                  "});",
                  "",
                  "pm.collectionVariables.set('jobId', body.job_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "../testdata/sample.mzML"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "upload"
              ]
            },
            "description": "Stores the file, creates a PENDING job and publishes the ml_jobs message."
          }
        },
        {
          "name": "Poll job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('describes the job we just created', function () {",
                  "    pm.expect(body.job_id).to.eql(pm.collectionVariables.get('jobId'));",
                  "    pm.expect(body.original_filename).to.eql('sample.mzML');",
                  "});",
                  "",
                  "pm.test('the status is one of the four lifecycle values', function () {",
                  "    pm.expect(body.status).to.be.oneOf(['PENDING', 'PROCESSING', 'DONE', 'FAILED']);",
                  "});",
                  "",
                  "pm.test('a finished job carries a class and a probability', function () {",
                  "    if (body.status !== 'DONE') {",
                  "        pm.expect(body.predicted_class).to.be.oneOf([null, undefined]);",
                  "        return;",
                  "    }",
                  "    pm.expect(body.predicted_class).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.probability).to.be.within(0, 1);",
                  "    pm.expect(body.top_predictions).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Run this repeatedly to watch PENDING -> PROCESSING -> DONE while the worker consumes the queue."
          }
        },
        {
          "name": "Poll job until DONE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const attempts = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "",
                  "pm.test('responds 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (body.status === 'PENDING' || body.status === 'PROCESSING') {",
                  "    if (attempts < 15) {",
                  "        pm.collectionVariables.set('pollAttempts', attempts + 1);",
                  "        setTimeout(() => {}, 1000);",
                  "        pm.execution.setNextRequest('Poll job until DONE');",
                  "        return;",
                  "    }",
                  "    pm.test('the worker finished within 15 polls', function () {",
                  "        pm.expect.fail(`still ${body.status} after ${attempts} polls - is the ml-worker running?`);",
                  "    });",
                  "}",
                  "",
                  "pm.collectionVariables.set('pollAttempts', 0);",
                  "",
                  "pm.test('the job reached DONE', function () {",
                  "    pm.expect(body.status).to.eql('DONE');",
                  "});",
                  "",
                  "pm.test('the prediction payload is complete', function () {",
                  "    pm.expect(body.predicted_class).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.probability).to.be.within(0, 1);",
                  "    pm.expect(body.model_version).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.confidence_label).to.be.oneOf(['Confident', 'Low confidence']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Re-runs itself until the worker finishes, up to 15 attempts. Requires the ml-worker container and a model artifact."
          }
        }
      ]
    },
